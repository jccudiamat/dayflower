# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets — Supabase keys, SMTP creds, dev login
.env
website/.env.local

# Publisher credentials for tool/publish_update.dart. Kept OUT of .env on
# purpose: .env is a Flutter asset, so anything in it ships inside the APK,
# and this file holds the service-role key.
.publish.env

# Node / Next.js (website/)
node_modules/
website/.next/
# Running `next build` from the repo root instead of website/ drops a
# stray .next/ here (trace files only). Ignore it rather than committing it.
/.next/
website/tsconfig.tsbuildinfo

# Raw artwork originals — processed into assets/images/flowers/
design/flower-source/

# Pre-migration database dumps (tool/run_sql.dart). These are REAL financial
# rows — accounts, balances and every transaction — so they must never leave
# the machine they were taken on.
backups/

# Machine-specific: absolute SDK paths, regenerated by `flutter pub get`.
android/local.properties
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh

# Claude Code's per-machine permission allowlist. It records whole approved
# commands verbatim — including curl calls with Authorization headers — so it
# has held live bearer tokens. Machine-local by convention; never commit it.
.claude/settings.local.json
.claude/launch.json
