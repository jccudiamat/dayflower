<?xml version="1.0" encoding="utf-8"?>
<!-- The bloom of light over the scene's heart as it beats (drawable/hb_glow):
     up quickly with the first swell, then out as it widens. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false"
    android:fillAfter="true">
    <scale
        android:fromXScale="0.6"
        android:toXScale="1.2"
        android:fromYScale="0.6"
        android:toYScale="1.2"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="760"
        android:interpolator="@android:anim/decelerate_interpolator" />
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1"
        android:duration="120"
        android:interpolator="@android:anim/linear_interpolator" />
    <alpha
        android:fromAlpha="1"
        android:toAlpha="0"
        android:startOffset="120"
        android:duration="640"
        android:interpolator="@android:anim/accelerate_interpolator" />
</set>
