<?xml version="1.0" encoding="utf-8"?>
<!-- A ripple on the heartbeat widget: a heart's outline, which grows out of
     the scene's heart and fades (anim/hb_ring, anim/hb_echo). White, and
     tinted per pulse: pink for a beat sent, lavender for one arrived.

     Two strokes on one path: a fine line, and a wide faint one under it,
     so it glows the way the moon scene's own ring does rather than reading
     as a hard outline.

     The outline is 20 of the 24 wide, and the view shows it at the widget's
     width, so at its starting scale it sits just outside a heart 0.36 of
     the width across, which is what every scene's heart is
     (tool/make_heartbeat_art.py). Nudged up by the heart's own offset in
     this path, so its middle is the view's middle, where it grows from. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group android:translateY="-0.18">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#38FFFFFF"
            android:strokeWidth="1.3"
            android:strokeLineJoin="round"
            android:pathData="M12,21.35l-1.45,-1.32C5.4,15.36 2,12.28 2,8.5 2,5.42 4.42,3 7.5,3c1.74,0 3.41,0.81 4.5,2.09C13.09,3.81 14.76,3 16.5,3 19.58,3 22,5.42 22,8.5c0,3.78 -3.4,6.86 -8.55,11.54L12,21.35z" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="0.32"
            android:strokeLineJoin="round"
            android:pathData="M12,21.35l-1.45,-1.32C5.4,15.36 2,12.28 2,8.5 2,5.42 4.42,3 7.5,3c1.74,0 3.41,0.81 4.5,2.09C13.09,3.81 14.76,3 16.5,3 19.58,3 22,5.42 22,8.5c0,3.78 -3.4,6.86 -8.55,11.54L12,21.35z" />
    </group>
</vector>
