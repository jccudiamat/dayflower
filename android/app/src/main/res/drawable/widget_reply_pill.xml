<?xml version="1.0" encoding="utf-8"?>
<!-- The reply pill on the day-photo widget.

     An outline rather than a fill, so it reads as an input on top of an
     arbitrary photo without hiding the part of the picture behind it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#33000000" />
    <stroke android:width="1dp" android:color="#8CFFFFFF" />
    <corners android:radius="17dp" />
</shape>
