<?xml version="1.0" encoding="utf-8"?>
<!-- Midnight-plum card matching AppGradients.hero. The radius is kept in
     step with CORNER_DP in TodaysTulipWidget, which clips photos to it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#171027"
        android:endColor="#120C1F" />
    <corners android:radius="20dp" />
</shape>
