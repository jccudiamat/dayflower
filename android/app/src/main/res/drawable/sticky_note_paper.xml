<?xml version="1.0" encoding="utf-8"?>
<!-- The paper, white so setColorFilter can tint it to any of the five note
     colours. A coloured drawable would multiply with the filter and come out
     muddy.

     Barely rounded: paper is cut, not moulded. The app's 18pt card radius is
     what makes something read as a surface rather than a sheet. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:radius="5dp" />
</shape>
