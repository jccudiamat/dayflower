<?xml version="1.0" encoding="utf-8"?>
<!-- The heartbeat widget's "Tap to send" button, as the designs draw it:
     a berry capsule with a brighter pink rim and a faint glow round it.
     Colours sampled from the supplied art (assets/heartbeat/src). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#2EE24F88" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="270"
                android:startColor="#F5972F62"
                android:endColor="#F5782250" />
            <stroke
                android:width="1.5dp"
                android:color="#E6E2508A" />
        </shape>
    </item>
</layer-list>
