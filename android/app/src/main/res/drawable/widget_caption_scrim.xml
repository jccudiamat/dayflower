<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-up scrim behind the widget caption.

     A full-bleed photo can be any brightness, and white text on a pale sky is
     unreadable. The gradient fades to fully transparent well before the top,
     so on a dark photo it costs nothing visually while still guaranteeing
     contrast under the text. angle=90 puts startColor at the bottom. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:type="linear"
        android:startColor="#E6000000"
        android:centerColor="#73000000"
        android:endColor="#00000000" />
</shape>
