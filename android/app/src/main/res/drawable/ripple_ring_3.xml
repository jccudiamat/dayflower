<?xml version="1.0" encoding="utf-8"?>
<!-- Ripple frame 3 of 5 for the heartbeat widget. Plain white: the
     tint (pink for sent, lavender for received) and the fade are applied
     per frame in Kotlin via setColorFilter / setImageAlpha, so one set of
     rings serves both directions. See HeartbeatRipple. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="11dp" android:top="11dp"
          android:right="11dp" android:bottom="11dp">
        <shape android:shape="oval">
            <stroke android:width="2.0dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
