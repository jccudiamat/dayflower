<?xml version="1.0" encoding="utf-8"?>
<!-- One day in the scrolling list (widget_list): the photo, and its own
     caption and heart, exactly as widget_photo_item has them for the
     rotation.

     🔴 **The photo decides the row's height.** A list row cannot be told
     "as tall as the card": RemoteViews has no way to size it before
     Android 12, and the launcher measures rows with no height to fill. So
     DayListService cuts each photo to the card's own shape, and
     adjustViewBounds turns that shape into the row's height at whatever
     width the list is. One day fills the card, and the next is one scroll
     away. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_day_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/widget_day_photo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:contentDescription="@string/widget_description" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_caption_scrim"
        android:paddingLeft="18dp"
        android:paddingRight="10dp"
        android:paddingTop="32dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/widget_day_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <ImageView
            android:id="@+id/widget_day_heart"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_heart_off"
            android:contentDescription="Love" />

        <ImageView
            android:id="@+id/widget_day_reply"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="-6dp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_reply"
            android:contentDescription="Reply" />
    </LinearLayout>
</FrameLayout>
