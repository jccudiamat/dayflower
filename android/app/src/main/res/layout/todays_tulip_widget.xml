<?xml version="1.0" encoding="utf-8"?>
<!-- Today's Flower home-screen widget, shaped like a story card.

     The photo is the widget: full-bleed, edge to edge, with the caption
     floating over it rather than sitting in a row beneath it. There is
     deliberately no header label — the picture says what it is, and a
     "A FLOWER FOR YOU" strip only ate the space the photo wanted.

     Values are written by TodaysTulipWidget.renderFlower() from the data
     DayflowerWidgets.syncFlower() pushes across; the ids here are that
     contract, so renaming one means changing the Kotlin too.

     FrameLayout, ImageView, LinearLayout and TextView are all on the
     RemoteViews-supported list — nothing here needs a custom view. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!-- The photo, when there is a live one. centerCrop is what makes it fill
         a widget of any aspect without letterboxing; Android 12+ launchers
         round the widget's corners for us, so the bitmap needs no mask. -->
    <ImageView
        android:id="@+id/widget_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/widget_description"
        android:visibility="gone" />

    <!-- No photo: the flower glyph carries the card instead, centred and
         large so the widget still reads as a picture rather than a form. -->
    <TextView
        android:id="@+id/widget_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="🌷"
        android:textSize="68sp" />

    <!-- Story header: avatar, whose day it is, and how long it has left.
         Sits on its own top scrim so it stays legible over a bright photo.
         Hidden wholesale when there is no live photo — a name and a
         countdown over the fallback flower glyph would be describing
         something that isn't there. -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_header_scrim"
        android:paddingLeft="10dp"
        android:paddingRight="12dp"
        android:paddingTop="9dp"
        android:paddingBottom="26dp"
        android:visibility="gone">

        <!-- Their face, or their flower.

             Two views stacked rather than one, because RemoteViews cannot
             swap a TextView for an ImageView and cannot clip a bitmap to a
             circle either. The photo is rounded in Dart before it is
             cached, so what arrives here is already circular with a
             transparent corner — see DayflowerWidgets._cacheAvatar. -->
        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="30dp">

            <TextView
                android:id="@+id/widget_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/avatar_circle"
                android:gravity="center"
                android:text="?"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_avatar_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@string/widget_description"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_owner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <!-- "16h" — what is left of the 24, so the widget says how long it
             has rather than only that something is there. -->
        <TextView
            android:id="@+id/widget_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text=""
            android:textColor="#D8CFE8"
            android:textSize="12sp"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />
    </LinearLayout>

    <!-- Caption. Sits on the scrim at the bottom edge, story-style. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/widget_caption_scrim"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="32dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Nothing here yet"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <TextView
            android:id="@+id/widget_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Tap to send a flower."
            android:textColor="#E4DEEC"
            android:textSize="12.5sp"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <!-- Reply bar, shaped after a story's.

             ⚠️ The pill is a TextView, not an input. A home-screen widget
             cannot host a real text field — RemoteViews has no EditText on
             its supported list — so tapping it opens the conversation with
             the keyboard, which is the closest honest thing. Pretending to
             be a field that swallows the first sentence typed into it would
             be worse than an obvious door.

             Shown only alongside a live day photo: there is nothing to
             reply to when the widget is showing its fallback glyph. -->
        <LinearLayout
            android:id="@+id/widget_reply_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_reply_pill"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/widget_reply_pill"
                android:gravity="center_vertical"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Send message"
                android:textColor="#F0EAF6"
                android:textSize="13sp" />

            <!-- A tulip, not a heart. Every reaction in this app is a
                 flower; a heart here would be borrowed from another app. -->
            <TextView
                android:id="@+id/widget_reply_tulip"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:layout_marginLeft="6dp"
                android:gravity="center"
                android:text="🌷"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
