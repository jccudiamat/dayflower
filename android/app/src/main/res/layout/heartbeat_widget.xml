<?xml version="1.0" encoding="utf-8"?>
<!-- Heartbeat widget: a scene (the theme picked in Settings), "HEARTBEAT"
     over it and "Tap to send" under it, as the supplied designs have them.
     No counts: a tap sends a heartbeat, and a beat sent or arrived ripples.

     The scene fills the card, centre-cropped. Every scene has its big heart
     at its exact centre (tool/make_heartbeat_art.py), so the heart is the
     card's middle at any size or shape the launcher gives it, and the
     ripples, which grow from the card's middle, grow from the heart. The
     title and the button are drawn here rather than baked into the picture,
     so they stay crisp and pinned to the top and the bottom.

     🔴 **The ripple is the launcher's animation, not the app's.** Each
     moving part is in a ViewFlipper whose in-animation is the move: showing
     a child plays it, showing it again plays it again (HeartbeatRipple).
     The rings' flippers rest on an empty first child, so a widget drawn
     fresh shows no ring; the scene's flipper has only the scene.

     The rings are the last children, so they pass over the title and the
     button, not behind them: the user asked for the button behind.

     Tapping anywhere is HeartbeatTapReceiver: it ripples at once, then
     sends. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/beat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <ViewFlipper
        android:id="@+id/beat_art_flip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateFirstView="true"
        android:inAnimation="@anim/hb_thump">

        <ImageView
            android:id="@+id/beat_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/hb_art_moon"
            android:contentDescription="@string/heartbeat_widget_description" />
    </ViewFlipper>

    <!-- The words. Sized to the widget in code (HeartbeatWidget.sizeChrome),
         so the button is the same part of the card at any size: 2 by 2 on a
         phone was the size it looked too big at. The numbers here are the
         160 by 200dp default, and what the widget picker shows.

         dp, not sp: the words belong to the picture, and a larger system
         font would push the button over the scene again. Their distance
         from the edges is this frame's padding because RemoteViews can set
         a padding on any Android and a margin only from 12. -->
    <FrameLayout
        android:id="@+id/beat_chrome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/beat_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.32"
            android:text="@string/heartbeat_widget_label"
            android:textColor="#F5A5BF"
            android:textSize="12dp"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <LinearLayout
            android:id="@+id/beat_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/hb_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/beat_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/heartbeat_widget_prompt"
                android:textColor="#FDF0F5"
                android:textSize="10dp" />

            <ImageView
                android:id="@+id/beat_prompt_heart"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginLeft="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_heart_off"
                android:contentDescription="@null" />
        </LinearLayout>
    </FrameLayout>

    <ViewFlipper
        android:id="@+id/beat_glow_flip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateFirstView="true"
        android:inAnimation="@anim/hb_glow">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/beat_glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/hb_glow"
            android:contentDescription="@null" />
    </ViewFlipper>

    <ViewFlipper
        android:id="@+id/beat_ring_flip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateFirstView="true"
        android:inAnimation="@anim/hb_ring">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/beat_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/hb_ring"
            android:contentDescription="@null" />
    </ViewFlipper>

    <ViewFlipper
        android:id="@+id/beat_echo_flip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateFirstView="true"
        android:inAnimation="@anim/hb_echo">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/beat_echo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/hb_ring"
            android:contentDescription="@null" />
    </ViewFlipper>
</FrameLayout>
